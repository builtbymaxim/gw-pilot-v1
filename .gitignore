.venv/
__pycache__/
*.pyc
*.log
.ipynb_checkpoints/
.cache/
.env
.DS_Store

# PDFs (confidential documents)
inputs/*.pdf
data/*.pdf

# Large intermediate CSVs (regenerable)
fresh_candidates*.csv
prolific_items*.csv
prolific_survey*.csv

# Model caches
~/.cache/huggingface/

# Apple Numbers binary files
*.numbers

# Generated outputs (regenerable by pipeline)
outputs/*.json
outputs/*.csv
outputs/*.txt
outputs/*.png

# Mock test data (regenerable)
inputs/mock_sosci_export.csv

# Exception: survey construction artefacts (Part B thesis — tracked).
# Must come AFTER all general patterns to override them.
!archive_survey_drafts/
!archive_survey_drafts/**

# Participant data — must NOT be tracked (privacy/GDPR). Kept locally only.
# Listed LAST so it overrides the archive_survey_drafts exception above.
data/sosci_export.csv
data/prolific_demographics.csv
archive_survey_drafts/prolific_survey_key.csv
